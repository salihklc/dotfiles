# Copy to ~/.config/dotfiles-secrets.env (chmod 600). Never commit the real file.

# mlplatform / pi
export GENAI_API_KEY=""
export ANTHROPIC_AUTH_TOKEN=""

# GitLab npm / netrc
export CI_JOB_TOKEN=""
export NPM_TOKEN="${CI_JOB_TOKEN:-}"
export GITLAB_LOGIN=""
export GITLAB_TOKEN="${CI_JOB_TOKEN:-}"

# git identity (optional — apply-gitconfig.sh)
export GIT_USER_NAME=""
export GIT_USER_EMAIL=""

export JIRA_TOKEN=""
