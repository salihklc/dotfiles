# Tek kaynak (public dotfiles): ~/.config/dotfiles-secrets.env
# Jarvis repo’da kopya yok — mlplatform + GitLab token’ları burada.
# Copy: dotfiles/modules/shell/bootstrap.sh veya: cp secrets/dotfiles-secrets.env.example ~/.config/dotfiles-secrets.env
# chmod 600. Never commit the real file.

# mlplatform / pi (GENAI_API_KEY yalnızca burada)
export GENAI_API_KEY=""
export ANTHROPIC_AUTH_TOKEN=""

# GitLab npm / netrc
export CI_JOB_TOKEN=""
export NPM_TOKEN="${CI_JOB_TOKEN:-}"
export GITLAB_LOGIN=""
export GITLAB_TOKEN="${CI_JOB_TOKEN:-}"

# git identity (optional — apply-gitconfig.sh)
export GIT_USER_NAME=""
export GIT_USER_EMAIL=""

export JIRA_TOKEN=""

# Drawty MCP (pi mcp — Authorization + X-Team-Id; ~/.pi/mcp.json runtime ${VAR})
export DRAWTY_API_KEY=""
export DRAWTY_TEAM_ID=""
